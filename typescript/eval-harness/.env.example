# The judge runs on Amazon Bedrock through LangChain's Converse integration.
#
# Credentials are resolved by the AWS SDK default provider chain — environment
# variables, a shared profile (AWS_PROFILE), SSO, or a container/instance role.
# Do not put secrets in this file.
AWS_REGION=us-east-1
# AWS_PROFILE=my-sso-profile

# Bedrock model id. On-demand throughput requires a cross-region inference
# profile id (the `us.` / `eu.` / `apac.` prefixed form), not the bare model id.
JUDGE_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Overrides AWS_REGION for judge calls only, if the model lives elsewhere.
# JUDGE_AWS_REGION=us-west-2

# Judge prompt template to use. Bump this when the prompt wording changes.
JUDGE_PROMPT_VERSION=v1

# Judge sampling / transport settings.
JUDGE_TEMPERATURE=0
JUDGE_MAX_OUTPUT_TOKENS=512
JUDGE_TIMEOUT_MS=30000
JUDGE_MAX_RETRIES=3
JUDGE_RETRY_BASE_MS=250

# Judge calls in flight at once, and the per-candidate cap in pairwise mode.
JUDGE_CONCURRENCY=5
JUDGE_PAIRWISE_MAX_CHARS=4000

# Diagnostics on stderr: debug | info | warn | error | silent.
LOG_LEVEL=info

# Verdict cache.
JUDGE_CACHE_ENABLED=true
JUDGE_CACHE_DIR=.eval-cache

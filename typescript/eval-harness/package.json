{
  "name": "eval-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Score existing chat scenarios with an LLM judge and report pass rates.",
  "type": "module",
  "bin": {
    "eval-harness": "./src/index.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "eval": "node --env-file-if-exists=.env src/index.ts run",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/aws": "^1.4.3",
    "@langchain/core": "^1.2.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}

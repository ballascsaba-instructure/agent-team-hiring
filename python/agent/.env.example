# Copy to .env and adjust. Do not put secrets in this file.
#
# AWS credentials are NOT read from here. Bedrock uses the AWS SDK default
# provider chain: environment variables, AWS_PROFILE, SSO, or an instance role.

# Bedrock cross-region inference profile for the chat model.
AGENT_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Region to call Bedrock in. Falls back to AWS_REGION, then us-east-1.
AGENT_AWS_REGION=us-east-1
